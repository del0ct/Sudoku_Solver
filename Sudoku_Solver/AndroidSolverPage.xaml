<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sudoku_Solver.AndroidSolverPage"
             xmlns:locs="clr-namespace:Sudoku_Solver.Resources.Localisation" >

    
    <Grid x:Name="Layoot">
        <Image Source="andrsolver.png" Grid.ColumnSpan="70" Grid.RowSpan="2" Margin="10,5,0,5" IsEnabled="False" VerticalOptions="Center" HorizontalOptions="Start"/>
        <Label FontSize="32" x:Name="LabelSudoku" Text="Sudoku Solver" Grid.Column="2" Grid.ColumnSpan="70" Grid.RowSpan="2" Margin="0,0,10,0" VerticalOptions="Center" HorizontalOptions="End"/>
        <Button Text="{x:Static locs:String.erase}" Padding="0" FontSize="15" FontFamily="Bold" Clicked="Erase_Clicked" Grid.Row="22" Grid.Column="4" Grid.ColumnSpan="5"/>
        <Button Text="{x:Static locs:String.solve}" Padding="0" FontSize="15" FontFamily="Bold" Clicked="Solve_Clicked" Grid.Row="22" Grid.Column="12" Grid.ColumnSpan="5"/>
        <Grid Grid.Row="21" Grid.ColumnSpan="20" RadioButtonGroup.GroupName="EnterNum" ColumnSpacing="4" RowSpacing="3" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button BackgroundColor="BlueViolet" x:Name="num1" Text="1" FontSize="15" Grid.Column="1" Padding="0" Clicked="NumCheckedChanged"/>
            <Button BackgroundColor="gray" x:Name="num2" Text="2" FontSize="15" Grid.Column="2" Padding="0" Clicked="NumCheckedChanged"/>
            <Button BackgroundColor="Gray" x:Name="num3" Text="3" FontSize="15" Grid.Column="3" Padding="0" Clicked="NumCheckedChanged"/>
            <Button BackgroundColor="Gray" x:Name="num4" Text="4" FontSize="15" Grid.Column="4" Padding="0" Clicked="NumCheckedChanged"/>
            <Button BackgroundColor="Gray" x:Name="num5" Text="5" FontSize="15" Grid.Column="5" Padding="0" Clicked="NumCheckedChanged"/>
            <Button BackgroundColor="Gray" x:Name="num6" Text="6" FontSize="15" Grid.Column="6" Padding="0" Clicked="NumCheckedChanged"/>
            <Button BackgroundColor="Gray" x:Name="num7" Text="7" FontSize="15" Grid.Column="1" Grid.Row="1" Padding="0" Clicked="NumCheckedChanged"/>
            <Button BackgroundColor="Gray" x:Name="num8" Text="8" FontSize="15" Grid.Column="2" Grid.Row="1" Padding="0" Clicked="NumCheckedChanged"/>
            <Button BackgroundColor="Gray" x:Name="num9" Text="9" FontSize="15" Grid.Column="3" Grid.Row="1" Padding="0" Clicked="NumCheckedChanged"/>
            <Button BackgroundColor="Gray" x:Name="num0" Text="{x:Static locs:String.eraser}" FontSize="15" Padding="0" Grid.Column="4" Grid.ColumnSpan="3" Grid.Row="1" Clicked="NumCheckedChanged"/>
            <!--RadioButton CheckedChanged="NumCheckedChanged" Grid.Column="1" Content="1" VerticalOptions="Start" IsChecked="True"/>
            <RadioButton CheckedChanged="NumCheckedChanged" Grid.Column="2" Content="2" VerticalOptions="Start"/>
            <RadioButton CheckedChanged="NumCheckedChanged" Grid.Column="3" Content="3" VerticalOptions="Start"/>
            <RadioButton CheckedChanged="NumCheckedChanged" Grid.Column="4" Content="4" VerticalOptions="Start"/>
            <RadioButton CheckedChanged="NumCheckedChanged" Grid.Column="5" Content="5" VerticalOptions="Start"/>
            <RadioButton CheckedChanged="NumCheckedChanged" Grid.Column="6" Content="6" VerticalOptions="Start"/>
            <RadioButton CheckedChanged="NumCheckedChanged" Grid.Column="7" Content="7" VerticalOptions="Start"/>
            <RadioButton CheckedChanged="NumCheckedChanged" Grid.Column="8" Content="8" VerticalOptions="Start"/>
            <RadioButton CheckedChanged="NumCheckedChanged" Grid.Column="9" Content="9" VerticalOptions="Start"/>
            <RadioButton CheckedChanged="NumCheckedChanged" Grid.Column="7" Grid.ColumnSpan="12" Grid.RowSpan="2" Content="Eraser" VerticalOptions="End" Margin="0,0,0,10"/-->
        </Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
    </Grid>
</ContentPage>
