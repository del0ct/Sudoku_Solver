<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Sudoku_Solver.AppShellAndroid"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Sudoku_Solver"
             xmlns:locs="clr-namespace:Sudoku_Solver.Resources.Localisation"
             Title="Sudoku"
             IconImageSource="icon.ico">

        <FlyoutItem Title="{x:Static locs:String.solver}">
        <Tab>
            <ShellContent ContentTemplate="{DataTemplate local:AndroidSolverPage}"/>
        </Tab> 
    </FlyoutItem>
    <FlyoutItem Title="{x:Static locs:String.about}">
        <Tab>
            <ShellContent Title="{x:Static locs:String.about}" ContentTemplate="{DataTemplate local:AboutPage}"/>
        </Tab>
    </FlyoutItem>
</Shell>
